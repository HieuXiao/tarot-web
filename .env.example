# Frontend (Vite)
# Production API base URL (include /api)
VITE_API_BASE_URL=https://your-backend-domain.com/api

# Backend (Express)
# Allowed frontend origin for CORS
FRONTEND_ORIGIN=https://your-frontend-domain.com

# Session secret (use a long random string in production)
SESSION_SECRET=replace-with-long-random-secret

# Redis connection for session storage
REDIS_URL=redis://127.0.0.1:6379

# Optional prefix for Redis session keys
SESSION_PREFIX=mystic:

# Set true when frontend and backend are on different sites/domains over HTTPS
# This enables SameSite=None; Secure for the session cookie
CROSS_SITE_COOKIE=true
